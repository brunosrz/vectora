# Template de secrets para desenvolvimento local com `wrangler dev`
# Copiar para .dev.vars e preencher os valores
# Em produção: pnpm wrangler secret put <KEY>

# Como obter:
#   cat ~/.vectora/auth.key   (gerado automaticamente no primeiro boot do backend)
VECTORA_JWT_SECRET=

# Como obter:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   ou: openssl rand -hex 32
RELAY_HMAC_SECRET=

# Como obter: mesmo comando acima
# DEVE ser o mesmo valor em:
#   backend ~/.vectora/.env  → VECTORA_OAUTH_SECRET
#   company Vercel           → RELAY_OAUTH_SECRET
VECTORA_OAUTH_SECRET=
