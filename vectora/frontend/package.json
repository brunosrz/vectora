{
  "name": "vectora",
  "version": "0.1.2",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.5.0",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./lib/paraglide",
    "typecheck": "pnpm i18n:compile && tsr generate && tsc --noEmit",
    "lint:oxc": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "electron:start": "electron electron/dist/main.js",
    "electron:dist": "pnpm electron:build && electron-builder --config electron/electron-builder.yml",
    "electron:dist:win": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --win",
    "electron:dist:mac": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --mac",
    "electron:dist:linux": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --linux"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "electron-updater": "^6.8.9",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.21.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slider": "1.4.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "@tanstack/router-cli": "^1.167.18",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "immer": "^11.1.11",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "oxlint": "^1.73.0",
    "pdfjs-dist": "^6.1.200",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.3",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  }
}
