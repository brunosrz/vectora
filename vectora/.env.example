LLM_PROVIDER=google-genai
GOOGLE_API_KEY=
TAVILY_API_KEY=
COHERE_API_KEY=

# Opcional: LLM providers alternativos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=vectora

# ─── Storage mode ────────────────────────────────────────────────────────────
# lite     = SQLite + LanceDB (padrão, zero dependências externas)
# complete = PostgreSQL + Qdrant + Redis  →  iniciar com:
#            docker compose -f deploy/compose.dev.yml up -d
STORAGE_MODE=lite

# PostgreSQL (apenas STORAGE_MODE=complete)
POSTGRES_DSN=postgresql+asyncpg://vectora:vectora@localhost:5432/vectora

# Redis (apenas STORAGE_MODE=complete)
REDIS_URL=redis://localhost:6379/0

# Qdrant (apenas STORAGE_MODE=complete)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Docker / VPS ────────────────────────────────────────────────────────────
# Senhas dos serviços em produção (compose.complete.yml)
POSTGRES_USER=vectora
POSTGRES_PASSWORD=
POSTGRES_DB=vectora
REDIS_PASSWORD=

# Traefik (apenas se usar docker-compose.traefik.yml)
VECTORA_DOMAIN=vectora.seudominio.com
ACME_EMAIL=seuemail@exemplo.com

# ─── Licença / auth (services.vectora.company) ──────────────────────────────
# VECTORA_TOKEN: token de licença Pro (obtido em vectora.company/dashboard ou
# via `POST /license/connect` com email+senha). Ausente = Free.
VECTORA_TOKEN=

# VECTORA_OAUTH_SECRET: mesmo valor cadastrado em services/ via
# `wrangler secret put VECTORA_OAUTH_SECRET` — autentica o polling do gateway
# no fluxo de OAuth device-flow (`POST /license/oauth/init` +
# `GET /license/oauth/poll`).
VECTORA_OAUTH_SECRET=

# Overrides opcionais — os defaults já apontam para services.vectora.company
# e gateway.vectora.chat em produção; só mude para apontar a um services local
# (`wrangler dev`) ou self-hosted.
# VECTORA_LICENSE_URL=https://services.vectora.company/license/validate
# VECTORA_LICENSE_CONNECT_URL=https://services.vectora.company/license/agent-login
# VECTORA_LICENSE_PORTAL_URL=https://services.vectora.company/license/portal
# VECTORA_COMPANY_URL=https://vectora.company
# VECTORA_GATEWAY_URL=https://gateway.vectora.chat

# VECTORA_APP_SECRET: secret fixo por produto (embutido no binário Nuitka em
# builds de release, igual pra toda instalação) usado pelo GatewayClient pra
# autenticar POST /register no Worker do gateway. Vazio em dev local desliga
# o handshake de registro sem impedir o backend de iniciar.
# VECTORA_APP_SECRET=

# Pula a validação remota de licença (dev/CI apenas — nunca em produção).
# VECTORA_LICENSE_BYPASS=1

# ─── Sessão web do chat (auth local, independente do services) ──────────────
# VECTORA_ACCESS_TOKEN_MINUTES=15
# VECTORA_REFRESH_TOKEN_DAYS=7
# VECTORA_AUTH_REQUIRED=true

# Provider de secrets locais (keepass é o default multiplataforma)
# VECTORA_SECRETS_PROVIDER=keepass
