# =============================================================================
# vectora.company — Environment Variables
# =============================================================================
# Copiar para .env.local e preencher os valores.
# Variáveis com prefixo VITE_ são expostas ao cliente (browser-safe).
# Variáveis sem prefixo são server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# vectora-services (Cloudflare Worker — auth/billing/license/GDPR/api-keys)
# company fala com services server-to-server; nunca do browser.
# -----------------------------------------------------------------------------
SERVICES_URL=https://services.vectora.company

# -----------------------------------------------------------------------------
# Sentry
# Obter em: https://sentry.io/settings/<org>/projects/<project>/keys/
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=vectora
SENTRY_PROJECT=vectora-company
SENTRY_AUTH_TOKEN=                 # Para upload de source maps no build

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (proteção anti-bot em signup/login)
# A chave pública renderiza o widget aqui; a verificação do token acontece em
# services, não em company.
# Obter em: https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=           # Chave pública (exposta ao browser)

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------

# Google Analytics 4
# Obter em: https://analytics.google.com (Configurações > Fluxos de dados)
VITE_GA4_MEASUREMENT_ID=G-...

# Google Search Console (meta tag de verificação)
# Obter em: https://search.google.com/search-console
VITE_GOOGLE_SITE_VERIFICATION=

# Plausible (self-hosted em analytics.vectora.company)
VITE_PLAUSIBLE_DOMAIN=vectora.company

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
VITE_APP_URL=https://vectora.company
APP_URL=https://vectora.company

# 'waitlist' esconde o app e mostra só o CTA de lista de espera na landing;
# qualquer outro valor (ou vazio) mostra o produto normalmente.
VITE_LAUNCH_MODE=

# Preset do Nitro: 'vercel' em produção, 'node-server' em dev local sem Vercel
# NITRO_PRESET=node-server
