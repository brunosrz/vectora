# =============================================================================
# vectora.company — Environment Variables
# =============================================================================
# Copiar para .env.local e preencher os valores.
# Variáveis com prefixo VITE_ são expostas ao cliente (browser-safe).
# Variáveis sem prefixo são server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obter em: https://supabase.com/dashboard/project/<id>/settings/api
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...        # Chave publishable (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # Server-only — bypassa RLS, nunca no cliente
SUPABASE_JWT_SECRET=               # Para verificar JWTs em edge functions

# -----------------------------------------------------------------------------
# Sentry
# Obter em: https://sentry.io/settings/<org>/projects/<project>/keys/
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=vectora
SENTRY_PROJECT=vectora-company
SENTRY_AUTH_TOKEN=                 # Para upload de source maps no build

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (proteção anti-bot em signup/login)
# Obter em: https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=           # Chave pública (exposta ao browser)
TURNSTILE_SECRET_KEY=              # Chave secreta (server-only)

# -----------------------------------------------------------------------------
# Stripe (pagamentos INTL — USD)
# Obter em: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...    # Webhook signing secret

# Stripe Price IDs (configurar no Dashboard)
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# -----------------------------------------------------------------------------
# Asaas (pagamentos BR — PIX/Boleto/Cartão)
# Obter em: https://www.asaas.com/config/configuracoes
# -----------------------------------------------------------------------------
ASAAS_API_KEY=                     # $aact_... (produção) ou $aasp_... (sandbox)
ASAAS_WEBHOOK_TOKEN=               # Token para validar webhooks do Asaas
ASAAS_ENVIRONMENT=production       # production | sandbox

# -----------------------------------------------------------------------------
# Resend (email transacional)
# Obter em: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------

# Google Analytics 4
# Obter em: https://analytics.google.com (Configurações > Fluxos de dados)
VITE_GA4_MEASUREMENT_ID=G-...

# Google Search Console (meta tag de verificação)
# Obter em: https://search.google.com/search-console
VITE_GOOGLE_SITE_VERIFICATION=

# Plausible (self-hosted em analytics.vectora.company)
VITE_PLAUSIBLE_DOMAIN=vectora.company

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
VITE_APP_URL=https://vectora.company
APP_URL=https://vectora.company

# Preset do Nitro: 'vercel' em produção, 'node-server' em dev local sem Vercel
# NITRO_PRESET=node-server
