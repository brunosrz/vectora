<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Entitlements para o Vectora Desktop (.app).

        Aplicado em hardened runtime + notarização Apple. Sem essas
        permissões, o binário Nuitka empacotado como sidecar é rejeitado
        no boot do .app por causa de JIT/mmap dinâmico das libs Python
        (lancedb, pyarrow, asyncssh).
    -->

    <!-- Nuitka usa JIT / mmap dinâmico — sem isso libs C explodem. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Libs Python que carregam .dylib via ctypes em runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Rede: cliente para chamadas LLM/RAG e server para o backend
         FastAPI subir em 127.0.0.1:<porta efêmera>. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Acesso a arquivos escolhidos pelo usuário (trust folder + ingest
         + safe-roots). Sem isso o picker do Finder não funciona. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Permite spawn do sidecar Nuitka. -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
