# ============================================================================
# Vectora Web UI — Variáveis de Ambiente
# Copie para .env.local e preencha os valores
# ============================================================================

# URL do servidor LangGraph (langgraph dev ou langgraph serve)
# Desenvolvimento local: http://localhost:2024
# Produção: URL do seu servidor LangGraph
NEXT_PUBLIC_API_URL=http://localhost:2024

# Nome do grafo em langgraph.json (campo "graphs": {"vectora": ...})
NEXT_PUBLIC_ASSISTANT_ID=vectora

# ── Autenticação (opcional para desenvolvimento local) ──────────────────────
# Deixar comentado para rodar sem autenticação (localhost)
# Para produção com LangSmith: langsmith-api-key
# NEXT_PUBLIC_AUTH_SCHEME=langsmith-api-key

# ── LangSmith (necessário apenas com NEXT_PUBLIC_AUTH_SCHEME acima) ──────────
# LANGSMITH_API_KEY=sk_...

# ── Discovery Layer D1.1: Vectora MCP Server (opcional) ────────────────────
# URL do servidor MCP do Vectora — usado pelo proxy /api/tools/schema
# para buscar render_hints das tools dinamicamente.
# Se não configurado, a Web UI usa o schema estático embutido.
# Desenvolvimento: inicie com `vectora-mcp` (MCP_TRANSPORT=sse MCP_PORT=8000)
# VECTORA_MCP_URL=http://localhost:8000

# ── Produção com proxy Next.js (oculta a URL real do LangGraph) ─────────────
# NEXT_PUBLIC_API_URL=https://meu-dominio.com/api/langgraph  # rota proxy
# LANGGRAPH_API_URL=http://internal:2024                      # backend real (server-side)
