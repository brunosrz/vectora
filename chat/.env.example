# Vectora Chat Frontend — variáveis de ambiente
#
# Copie para .env.local e ajuste conforme necessário.
# Em desenvolvimento: vectora server headless --port 8080 (outro terminal)

# URL do servidor Vectora (vectora server chat ou headless)
NEXT_PUBLIC_VECTORA_API_URL=http://localhost:8080

