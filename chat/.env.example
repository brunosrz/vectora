# Vectora Chat Frontend — variáveis de ambiente
#
# Copie para .env.local e ajuste conforme necessário.
# Em desenvolvimento: vectora server headless --port 8080 (outro terminal)

# URL do servidor Vectora (vectora server chat ou headless)
NEXT_PUBLIC_VECTORA_API_URL=http://localhost:8080

# Autenticação obrigatória (padrão: true)
# Defina como "false" para desabilitar auth (modo dev local sem servidor)
NEXT_PUBLIC_VECTORA_AUTH_REQUIRED=true
VECTORA_AUTH_REQUIRED=true

# Removidas (não são mais necessárias):
# NEXT_PUBLIC_LANGGRAPH_API_URL
# NEXT_PUBLIC_LANGGRAPH_API_URL_EXTERNAL
# LANGSMITH_API_KEY
