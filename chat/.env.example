# Vectora Chat Frontend — variáveis de ambiente
#
# Copie para .env.local e ajuste conforme necessário.
# Em desenvolvimento: backend em http://127.0.0.1:8080 (proxy do Vite),
# frontend em http://localhost:5173 (Vite dev server).

# Override do URL do backend (opcional). Em prod (binário Nuitka) o
# FastAPI serve o frontend no mesmo origin, então pode ficar vazio.
# VITE_VECTORA_API_URL=http://localhost:8080

# Autenticação obrigatória (padrão: true).
# Defina como "false" para desabilitar o auth guard em dev local.
# VITE_VECTORA_AUTH_REQUIRED=true
