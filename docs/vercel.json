{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "curl -fsSL \"https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz\" -o /tmp/hugo.tar.gz && tar -xzf /tmp/hugo.tar.gz -C . hugo",
  "buildCommand": "./hugo --gc --minify",
  "outputDirectory": "public",
  "env": {
    "HUGO_VERSION": "0.163.3"
  }
}
